      "version": 50,
      "versionNonce": 1062439321,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794534835849,
      "created": 1794534811032,
      "link": null,
      "locked": false,
      "text": "Example : If one user subscribes to 3 symbols\n\nClient\n  <- one SSE connection -> Symbol service 1\n\nSymbol service 1 subscribes to\n  price:META\n  price:AAPL\n  price:TSLA\n\nRedis update on price:AAPL\n  -> Symbol service 1\n  -> client receives {\"symbol\":\"AAPL\",\"priceInCents\":...}",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Example : If one user subscribes to 3 symbols\n\nClient\n  <- one SSE connection -> Symbol service 1\n\nSymbol service 1 subscribes to\n  price:META\n  price:AAPL\n  price:TSLA\n\nRedis update on price:AAPL\n  -> Symbol service 1\n  -> client receives {\"symbol\":\"AAPL\",\"priceInCents\":...}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    }
