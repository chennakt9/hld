    {
      "id": "1LwP9738R2t3Co2Zfq0hC",
      "type": "text",
      "x": 413.60286458333337,
      "y": 1620.8776041666665,
      "width": 504.1915283203125,
      "height": 220,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3D",
      "roundness": null,
      "seed": 277955970,
      "version": 522,
      "versionNonce": 391013320,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794486430326,
      "link": null,
      "locked": false,
      "text": "1. random number generator (0-10^9) - 10 characters\n    - base62 encoded (0-9, A-Z, a-z)\n    - 62^6 = 56B\n    - Birthday paradox\n    - before insert into DB, check if already this shortUrl exists\n2. Hash the long url\n    - md5(longUrl) -> hash[:6]\n3. Counter\n    - increment a counter -> convert it to base62\n    - downsides - predictability\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. random number generator (0-10^9) - 10 characters\n    - base62 encoded (0-9, A-Z, a-z)\n    - 62^6 = 56B\n    - Birthday paradox\n    - before insert into DB, check if already this shortUrl exists\n2. Hash the long url\n    - md5(longUrl) -> hash[:6]\n3. Counter\n    - increment a counter -> convert it to base62\n    - downsides - predictability\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
