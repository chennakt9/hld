  "elements": [
    {
      "id": "bm8ETBELalasIIPt3w6y2",
      "type": "text",
      "x": 237.17010533591161,
      "y": 3393.8234027583935,
      "width": 731.639404296875,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aZ",
      "roundness": null,
      "seed": 1299636292,
      "version": 480,
      "versionNonce": 1505886664,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794366986428,
      "link": null,
      "locked": false,
      "text": "Deep dive 1 - How do we handle duplicate messages from coming through\n- The worker can lookup the message by id in DB.\n- check if message if present and it's status is successful, then dont send\n- else send",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Deep dive 1 - How do we handle duplicate messages from coming through\n- The worker can lookup the message by id in DB.\n- check if message if present and it's status is successful, then dont send\n- else send",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "mYYJaa8JF6KMi7KvnKn96",
      "type": "text",
      "x": 235.8029178359115,
      "y": 3744.0577777583935,
      "width": 604.2196044921875,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ab",
      "roundness": null,
      "seed": 473841988,
      "version": 1016,
      "versionNonce": 883853512,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794366986428,
      "link": null,
      "locked": false,
      "text": "Followup 1 - Should we use fanout on write vs fanout on read\n- few followers, use fanout on writes\n- millions of followers, use fanout on reads",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Followup 1 - Should we use fanout on write vs fanout on read\n- few followers, use fanout on writes\n- millions of followers, use fanout on reads",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "b2w4ceLUxo5P0GQtj6-hg",
      "type": "text",
      "x": 223.27144662551405,
      "y": 3946.938207970294,
      "width": 800,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ac",
      "roundness": null,
      "seed": 62203832,
      "version": 518,
      "versionNonce": 779235272,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794366986428,
      "created": 1794362859941,
      "link": null,
      "locked": false,
      "text": "Notification decider\n- To send a particular notification to a user or not\n- 5 notifications per day\n- \n\n\nFCM or APN vs HTTP\n- HTTP works only when client initiates the connection.. but FCM can directly\ndeliver \n- It can deliver the notification even when the app is closed",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Notification decider\n- To send a particular notification to a user or not\n- 5 notifications per day\n- \n\n\nFCM or APN vs HTTP\n- HTTP works only when client initiates the connection.. but FCM can directly deliver \n- It can deliver the notification even when the app is closed",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "2RrTOFnKsNho3WbaXJ54l",
      "type": "text",
      "x": 474.62763766205893,
      "y": -97.46793407734168,
      "width": 800,
      "height": 425,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ag",
      "roundness": null,
      "seed": 1913847752,
      "version": 22,
      "versionNonce": 758542520,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794366851866,
      "created": 1794366813246,
      "link": null,
      "locked": false,
      "text": "===APIs==\n\nPOST /notifications -> 200 OK { id, status }\nBody: {\n  userId,\n  channel,     // push | email | sms\n  priority,    // high | standard\n  content,     // { title, body }\n  scheduledAt  // optional, defaults to now\n}\n\nPUT /users/{userId}/preferences -> Preferences\nBody: {\n  optOuts,     // e.g. [\"sms\"]\n  quietHours   // e.g. { start: \"22:00\", end: \"08:00\", tz }\n}\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "===APIs==\n\nPOST /notifications -> 200 OK { id, status }\nBody: {\n  userId,\n  channel,     // push | email | sms\n  priority,    // high | standard\n  content,     // { title, body }\n  scheduledAt  // optional, defaults to now\n}\n\nPUT /users/{userId}/preferences -> Preferences\nBody: {\n  optOuts,     // e.g. [\"sms\"]\n  quietHours   // e.g. { start: \"22:00\", end: \"08:00\", tz }\n}\n",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
