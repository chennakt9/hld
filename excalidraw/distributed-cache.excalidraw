    {
      "id": "WCFEzzgkfepzDMl3VcLKj",
      "type": "text",
      "x": 52.3515625,
      "y": 1115.62109375,
      "width": 800,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4a",
      "roundness": null,
      "seed": 1907630169,
      "version": 104,
      "versionNonce": 227426713,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794576489383,
      "created": 1794575091901,
      "link": null,
      "locked": false,
      "text": "==Hot reads==\n- read replicas\n- copies of hot keys using suffixes\n    - user:123#1 -> Node A stores a copy\n    - user:123#2 -> Node B stores a copy\n    - user:123#3 -> Node C stores a copy\n    - These copies get distributed to different nodes via consistent hashing\n    - For reads, clients randomly choose one of the suffixed keys, spreading read\nload across multiple nodes\n    - For writes, the system must update all copies to maintain consistency\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "==Hot reads==\n- read replicas\n- copies of hot keys using suffixes\n    - user:123#1 -> Node A stores a copy\n    - user:123#2 -> Node B stores a copy\n    - user:123#3 -> Node C stores a copy\n    - These copies get distributed to different nodes via consistent hashing\n    - For reads, clients randomly choose one of the suffixed keys, spreading read load across multiple nodes\n    - For writes, the system must update all copies to maintain consistency\n",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "91zeHjLfC8gQqoImNSUYG",
